package pages

import "github.com/printfromai/core/web/templates/layout"

// AuthIndex handles the HTMX conditional rendering for the Auth Gate.
templ AuthIndex(isHTMX bool) {
	if isHTMX {
		@AuthContent()
	} else {
		@layout.Base("Log In or Register | PrintFromAI") {
			@AuthContent()
		}
	}
}

// AuthContent provides a minimalist, high-converting login and registration UI.
templ AuthContent() {
	<div class="flex flex-col items-center justify-center min-h-[80vh] w-full p-6 transition-colors duration-300">
		<div class="w-full max-w-md bg-white dark:bg-[#151515] rounded-3xl border border-gray-200 dark:border-gray-800 p-8 shadow-sm">
			
			<div class="text-center mb-8">
				<h1 class="text-2xl font-medium text-gray-900 dark:text-gray-100 tracking-tight mb-2">Welcome Back</h1>
				<p class="text-sm text-gray-500 dark:text-gray-400 font-light">Sign in to save your AI print designs or track an order.</p>
			</div>

			<!-- Error Message Container -->
			<div id="auth-error" class="hidden mb-6 p-4 rounded-xl bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800/50 text-sm text-red-600 dark:text-red-400 text-center"></div>

			<!-- Google Sign In -->
			<button type="button" onclick="signInWithGoogle()" class="w-full flex items-center justify-center gap-3 bg-white dark:bg-[#1A1A1A] border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-[#222] text-gray-800 dark:text-gray-200 font-medium py-3 px-4 rounded-xl transition-all shadow-sm outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer mb-6">
				<svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
					<path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path>
					<path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
					<path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"></path>
					<path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path>
				</svg>
				Continue with Google
			</button>

			<div class="relative flex items-center py-2 mb-6">
				<div class="flex-grow border-t border-gray-200 dark:border-gray-800"></div>
				<span class="flex-shrink-0 mx-4 text-xs text-gray-400 font-light uppercase tracking-wider">Or</span>
				<div class="flex-grow border-t border-gray-200 dark:border-gray-800"></div>
			</div>

			<!-- Email / Password Form -->
			<form id="email-auth-form" onsubmit="handleEmailAuth(event)" class="space-y-4">
				<div>
					<label for="email" class="sr-only">Email address</label>
					<input id="email" name="email" type="email" autocomplete="email" required placeholder="Email address" class="w-full p-3.5 bg-gray-50 dark:bg-[#111] border border-gray-200 dark:border-gray-800 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 dark:text-gray-200 text-sm shadow-sm transition-colors" />
				</div>
				<div>
					<label for="password" class="sr-only">Password</label>
					<input id="password" name="password" type="password" autocomplete="current-password" required placeholder="Password" class="w-full p-3.5 bg-gray-50 dark:bg-[#111] border border-gray-200 dark:border-gray-800 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 dark:text-gray-200 text-sm shadow-sm transition-colors" />
				</div>

				<button type="submit" id="auth-submit-btn" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-medium py-3.5 px-4 rounded-xl transition-all shadow-md hover:shadow-indigo-500/25 tracking-wide outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer text-sm mt-2">
					Sign In / Register
				</button>
			</form>

			<!-- Guest Checkout Fast Track -->
			<div class="mt-8 text-center border-t border-gray-100 dark:border-gray-800/60 pt-6">
				<p class="text-sm text-gray-500 dark:text-gray-400 mb-3 font-light">In a rush?</p>
				<a href="/checkout" hx-get="/checkout" hx-target="#main-content" hx-push-url="true" class="text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 transition-colors outline-none">
					Continue as Guest &rarr;
				</a>
			</div>
		</div>
	</div>

	<!-- Zero-Latency Client-Side Auth Logic -->
	<script type="module">
		import { getAuth, GoogleAuthProvider, signInWithPopup, signInWithEmailAndPassword, createUserWithEmailAndPassword, fetchSignInMethodsForEmail } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
		
		const auth = getAuth();
		const provider = new GoogleAuthProvider();

		const showError = (msg) => {
			const errDiv = document.getElementById('auth-error');
			errDiv.textContent = msg;
			errDiv.classList.remove('hidden');
		};

		window.signInWithGoogle = async () => {
			try {
				await signInWithPopup(auth, provider);
				// Firebase automatically merges anonymous carts if structured correctly.
				// Route directly to checkout on success.
				htmx.ajax('GET', '/checkout', {target: '#main-content', swap: 'innerHTML'});
				window.history.pushState({}, '', '/checkout');
			} catch (error) {
				showError("Google sign in failed. Please try again.");
				console.error(error);
			}
		};

		window.handleEmailAuth = async (e) => {
			e.preventDefault();
			const email = document.getElementById('email').value;
			const password = document.getElementById('password').value;
			const btn = document.getElementById('auth-submit-btn');
			
			btn.innerHTML = 'Processing...';
			btn.classList.add('opacity-75', 'pointer-events-none');

			try {
				// 1. Try to sign in first
				try {
					await signInWithEmailAndPassword(auth, email, password);
				} catch (err) {
					// 2. If user doesn't exist, create them seamlessly
					if (err.code === 'auth/user-not-found' || err.code === 'auth/invalid-credential') {
						try {
							await createUserWithEmailAndPassword(auth, email, password);
						} catch (createErr) {
							throw createErr; // Pass to outer catch
						}
					} else {
						throw err; // Wrong password or other error
					}
				}
				
				// Success! Route to checkout.
				htmx.ajax('GET', '/checkout', {target: '#main-content', swap: 'innerHTML'});
				window.history.pushState({}, '', '/checkout');

			} catch (error) {
				if (error.code === 'auth/wrong-password') {
					showError("Incorrect password. Please try again.");
				} else if (error.code === 'auth/weak-password') {
					showError("Password should be at least 6 characters.");
				} else {
					showError("Authentication failed. Please check your credentials.");
				}
				btn.innerHTML = 'Sign In / Register';
				btn.classList.remove('opacity-75', 'pointer-events-none');
			}
		};
	</script>
}